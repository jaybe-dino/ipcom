# REMIX HUB — environment template. Copy to .env (gitignored) and fill in.

# --- API server ---
PORT=4000

# --- Storage engine (Repo) ---
# Priority: DATABASE_URL > USE_PGLITE > in-memory (default).
# Production Postgres:
# DATABASE_URL=postgres://user:pass@localhost:5432/remixhub
# Embedded Postgres (PGlite) — real SQL, no server. Persist to a dir or run in-memory:
# USE_PGLITE=1
# PGLITE_DIR=./.pglite

# --- Auth ---
JWT_SECRET=change-me-in-production

# --- NVIDIA NIM (build.nvidia.com) AI plugin adapter ---
# Get a key at https://build.nvidia.com/ . When unset, the Plugin Gateway
# falls back to the local stub adapter so dev never hard-breaks.
NVIDIA_API_KEY=
NIM_BASE_URL=https://ai.api.nvidia.com/v1
# Per-capability models — set a model id to enable that capability.
# image defaults to SDXL when the key is present; the rest are opt-in.
NIM_IMAGE_MODEL=stabilityai/stable-diffusion-xl
# NIM_VIDEO_MODEL=
# NIM_MUSIC_MODEL=
# NIM_VOICE_MODEL=
# NIM_3D_MODEL=
# Async poll path template ({id} is substituted):
NIM_STATUS_PATH=/status/{id}

# --- Web client ---
# Base URL the web app calls. Defaults to "/api" (Vite dev proxy → :4000).
VITE_API_BASE=/api

# --- Higgsfield AI plugin adapter (preferred over NIM when set) ---
HIGGSFIELD_API_KEY=
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai/v1
HIGGSFIELD_STATUS_PATH=/jobs/{id}

# --- Moderation (real classifier drop-in) ---
# When set, generations are screened by this external model before the keyword net.
MODERATION_URL=
MODERATION_API_KEY=

# --- Provenance signing (C2PA-style detached signature on licenses) ---
PROVENANCE_SIGNING_KEY=change-me-in-production

# --- Asset storage ---
# Precedence: S3 (if S3_BUCKET + keys) → ASSET_DIR (filesystem/volume) → memory.
# Set ASSET_DIR to a writable dir/volume for persistent storage across restarts.
ASSET_DIR=
# Object storage + CDN for horizontal scale. Works with AWS S3, Cloudflare R2,
# MinIO, and GCS interop (set S3_ENDPOINT for non-AWS). Uses SigV4 (no SDK).
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=

# --- Payments (settlement charge) ---
# Set to enable real charges via Stripe; unset → mock (auto-succeeds in dev).
STRIPE_SECRET_KEY=
STRIPE_BASE_URL=https://api.stripe.com/v1
